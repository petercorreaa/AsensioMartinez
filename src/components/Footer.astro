---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import logoLight from '../assets/brand/logo-light.png';
import { site, direccionCompleta } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-white">
  <div class="container-xl py-16 md:py-20">
    <div
      class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.2fr] lg:gap-8"
    >
      <div>
        {
          /*
          logo-light.png: la misma pieza que el header, pero con "ASENSIO
          MARTÍNEZ" recoloreado a blanco — el negro original desaparece
          contra el fondo navy-900 del footer. "ESTUDIO CONTABLE" se queda
          en brand-600, el mismo teal de siempre, porque ahí sí contrasta.
        */
        }
        <Image
          src={logoLight}
          alt={site.nombre}
          height={48}
          densities={[1, 2, 3]}
          class="h-12 w-auto"
        />
        <p class="mt-5 max-w-[32ch] text-[15px] leading-relaxed text-white/80">
          Estudio contable en {site.ciudad} desde {site.fundacion}.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {
            site.diferenciales.map((item) => (
              <li class="bg-white/10 px-3 py-1 text-[13px] font-medium text-white/90">
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="font-display text-sm font-semibold tracking-wide text-white uppercase"
        >
          Servicios
        </h3>
        <ul class="mt-5 flex flex-col gap-3">
          {
            site.serviciosFooter.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-brand-600 text-[15px] text-white/80 transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="font-display text-sm font-semibold tracking-wide text-white uppercase"
        >
          Estudio
        </h3>
        <ul class="mt-5 flex flex-col gap-3">
          {
            site.estudioFooter.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="hover:text-brand-600 text-[15px] text-white/80 transition-colors duration-200"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="font-display text-sm font-semibold tracking-wide text-white uppercase"
        >
          Contacto
        </h3>
        <ul class="mt-5 flex flex-col gap-3 text-[15px] text-white/80">
          <li class="flex items-start gap-2">
            <Icon
              name="lucide:map-pin"
              class="text-brand-600 mt-0.5 size-4 shrink-0"
              aria-hidden="true"
            />
            <span>{direccionCompleta}</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon
              name="simple-icons:whatsapp"
              class="text-brand-600 size-4 shrink-0"
              aria-hidden="true"
            />
            <a
              href={site.whatsappHref}
              target="_blank"
              rel="noopener"
              class="hover:text-brand-600 transition-colors duration-200"
            >
              {site.whatsapp}
            </a>
          </li>
          {
            Object.values(site.emails).map((email) => (
              <li class="flex items-center gap-2">
                <Icon
                  name="lucide:mail"
                  class="text-brand-600 size-4 shrink-0"
                  aria-hidden="true"
                />
                <a
                  href={`mailto:${email}`}
                  class="hover:text-brand-600 transition-colors duration-200"
                >
                  {email}
                </a>
              </li>
            ))
          }
          <li class="flex items-center gap-2">
            <Icon
              name="lucide:clock"
              class="text-brand-600 size-4 shrink-0"
              aria-hidden="true"
            />
            <span>{site.horario}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-xl flex flex-col items-center justify-between gap-4 py-6 text-sm text-white/60 sm:flex-row"
    >
      <p>© {year} {site.nombre}. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a
          href="/politica-de-privacidad"
          class="hover:text-brand-600 text-white/80 transition-colors duration-200"
        >
          Política de privacidad
        </a>
        <a
          href={site.linkedinHref}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn de Asensio Martínez"
          class="hover:text-brand-600 text-white/80 transition-colors duration-200"
        >
          <Icon name="lucide:linkedin" class="size-5" aria-hidden="true" />
        </a>
        <a
          href={site.instagramHref}
          target="_blank"
          rel="noopener"
          aria-label="Instagram de Asensio Martínez"
          class="hover:text-brand-600 text-white/80 transition-colors duration-200"
        >
          <Icon name="lucide:instagram" class="size-5" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</footer>
