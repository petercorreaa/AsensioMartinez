---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';

// Lo que se muestra en pantalla es la dirección tal cual la usa el estudio,
// con el "e/ 2 y 3". Para las URLs de Maps se usa site.direccionMaps, que es
// la misma dirección en el formato que entiende el geocoder (ver site.ts).
const direccionCorta = `${site.direccion}, ${site.ciudad}, ${site.provincia}`;
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.direccionMaps)}`;
---

<Section id="contacto" background="tint" class="scroll-mt-32">
  <SectionHeading
    eyebrow="Contacto"
    title="Contanos tu caso"
    subtitle="Escribinos por WhatsApp o por mail y coordinamos una primera reunión sin cargo. Te respondemos dentro de las 24 horas hábiles."
  />

  {
    /*
    Sin formulario: los canales son WhatsApp y las casillas de los socios,
    así que las dos cards que quedan —datos y mapa— pesan lo mismo y van
    mitad y mitad, en vez del 7/5 que necesitaba el formulario.
  */
  }
  <div class="mt-14 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-stretch">
    {/* ---------------- Columna izquierda: datos ---------------- */}
    <div>
      <Card padding="lg" class="flex h-full flex-col">
        <ul class="mb-10 flex flex-col gap-5">
          <li class="flex items-start gap-3">
            <Icon
              name="lucide:map-pin"
              class="text-brand-600 mt-0.5 size-5 shrink-0"
              aria-hidden="true"
            />
            <span>{direccionCorta}</span>
          </li>

          {
            /*
            "destacado" respecto de los demás datos: fondo brand-50 propio,
            en vez del list-item liso que usan dirección/mails/horario.
            Es el canal principal del estudio.
          */
          }
          <li class="bg-brand-50 -mx-2 flex items-center gap-3 px-2 py-2">
            <Icon
              name="simple-icons:whatsapp"
              class="size-5 shrink-0 text-[#25D366]"
              aria-hidden="true"
            />
            <a
              href={site.whatsappHref}
              target="_blank"
              rel="noopener"
              class="text-accent-700 hover:text-accent-800 font-semibold"
            >
              {site.whatsapp}
            </a>
          </li>

          {
            Object.values(site.emails).map((email) => (
              <li class="flex items-center gap-3">
                <Icon
                  name="lucide:mail"
                  class="text-brand-600 size-5 shrink-0"
                  aria-hidden="true"
                />
                {/*
                  break-all: estas casillas miden ~30 caracteres sin un solo
                  espacio donde cortar, y en un teléfono angosto desbordan la
                  card si no se les permite partir a mitad de palabra.
                */}
                <a
                  href={`mailto:${email}`}
                  class="hover:text-accent-700 break-all transition-colors duration-200"
                >
                  {email}
                </a>
              </li>
            ))
          }

          <li class="flex items-center gap-3">
            <Icon
              name="lucide:clock"
              class="text-brand-600 size-5 shrink-0"
              aria-hidden="true"
            />
            <span>{site.horario}</span>
          </li>
        </ul>

        {
          /*
          El aire mínimo va como mb-10 de la <ul>, no como padding del botón:
          Button ya trae su propio py-4, y sumarle un pt-* lo dejaría con el
          padding descompensado en vez de separarlo de la lista.

          El mt-auto del botón sigue igual, para que quede pegado al fondo de
          la card cuando el grid la estira a la altura del mapa. Los dos se
          suman: cuando sobra alto manda el auto, y cuando la card viene justa
          —que es cuando antes quedaban casi pegados— el mb-10 garantiza la
          separación igual.
        */
        }
        <Button
          href={site.whatsappHref}
          target="_blank"
          rel="noopener"
          variant="primary"
          size="lg"
          class="mt-auto w-full"
        >
          <Icon
            name="simple-icons:whatsapp"
            class="size-5 shrink-0"
            aria-hidden="true"
          />
          Escribinos por WhatsApp
        </Button>
      </Card>
    </div>

    {/* ---------------- Columna derecha: mapa ---------------- */}
    <div>
      {
        /*
        div plano, no <Card>: un <!-- --> comentado como hijo del slot de un
        componente Astro se borra en la compilación (lo verifiqué con un
        repro aislado), aunque el mismo comentario sobrevive intacto como
        hijo de un elemento HTML normal. Las clases de acá replican a mano
        las de Card.astro para mantener el mismo look.
      */
      }
      <div
        class="group border-line shadow-soft hover:border-accent-700 relative aspect-[4/3] overflow-hidden border bg-white transition-[border-color,transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 lg:aspect-auto lg:h-full"
      >
        {
          /*
          aspect-[4/3] en mobile (una sola columna, la caja define su propia
          altura como cualquier imagen) y lg:aspect-auto lg:h-full en
          desktop, donde en cambio tiene que igualar la altura de la card de
          datos de al lado (estirada por el lg:items-stretch del grid).

          loading="lazy" en el iframe: el embed de Google Maps mete cookies
          y trackers de terceros, así que no tiene sentido cargarlo hasta
          que esté por entrar en pantalla.
        */
        }
        <iframe
          src={`https://maps.google.com/maps?q=${encodeURIComponent(site.direccionMaps)}&output=embed`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa - ${direccionCorta}`}
          class="block h-full w-full border-0"></iframe>

        {
          /*
          pointer-events-none en el wrapper, pointer-events-auto de vuelta en
          el botón: si no, este div — aunque sólo se VE el botón en el
          centro — igual tapa el resto de la caja y no dejaría arrastrar ni
          hacer zoom en el mapa de abajo.
        */
        }
        <div
          class="pointer-events-none absolute inset-0 flex items-center justify-center"
        >
          <Button
            href={mapsHref}
            target="_blank"
            rel="noopener"
            variant="primary"
            class="pointer-events-auto"
          >
            <Icon name="lucide:navigation" class="size-4" aria-hidden="true" />
            Cómo llegar
          </Button>
        </div>
      </div>
    </div>
  </div>
</Section>
