---
import { Icon } from 'astro-icon/components';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const pasos = [
  {
    numero: '01',
    icon: 'lucide:calendar',
    titulo: 'Diagnóstico sin cargo',
    texto:
      'Nos contás dónde estás parado. Revisamos tu situación y te decimos con claridad qué hay que hacer y qué prioridad tiene cada cosa.',
  },
  {
    numero: '02',
    icon: 'lucide:clipboard-list',
    titulo: 'Plan de trabajo y presupuesto',
    texto:
      'Te presentamos un plan con alcance, plazos y honorarios definidos por escrito. Recién ahí decidís.',
  },
  {
    numero: '03',
    icon: 'lucide:settings',
    titulo: 'Puesta al día',
    texto:
      'Regularizamos lo pendiente, ordenamos la documentación y dejamos tu situación contable e impositiva en regla.',
  },
  {
    numero: '04',
    icon: 'lucide:headphones',
    titulo: 'Acompañamiento mensual',
    texto:
      'Vencimientos, liquidaciones y consultas del día a día, con un contador asignado que conoce tu negocio.',
  },
];
---

<Section
  id="como-trabajamos"
  background="navy"
  class="relative scroll-mt-32 overflow-hidden"
>
  {
    /* Misma figura que el hero, en la esquina opuesta para variar la composición. */
  }
  <div
    class="brand-shape-growth pointer-events-none absolute -top-24 -right-24 h-[420px] w-[520px] rotate-180"
    aria-hidden="true"
  >
  </div>

  <SectionHeading
    eyebrow="Cómo trabajamos"
    title="Un proceso claro, sin sorpresas"
    subtitle="Sabés desde el primer día qué vamos a hacer, en cuánto tiempo y cuánto cuesta."
    tone="dark"
  />

  {
    /*
    Desktop: grid de 4 columnas sin gap — el espaciado visual lo da el padding
    interno de cada <li>, no el gap del grid. Así el conector horizontal puede
    ir de "centro del ícono" a "+100% de ancho" y caer justo en el centro del
    ícono siguiente, sin tener que restarle el gap a la cuenta.
    Mobile: cada paso es una fila [riel de ícono + conector | contenido], el
    patrón clásico de timeline vertical. Se arma así (y no con una única línea
    vertical de punta a punta) porque la altura de cada paso varía según el
    largo del texto, y un riel por fila absorbe esa diferencia solo.
  */
  }
  {
    /*
    gap-y-0: en mobile el "aire" entre pasos lo da el propio largo del
    conector vertical (crece con flex-grow desde el ícono hasta la fila
    siguiente). Si el grid tuviera gap además, quedaría un tramo sin línea
    entre el final del conector y el próximo ícono.
  */
  }
  <div class="como-pasos mt-16 grid grid-cols-1 gap-0 lg:grid-cols-4">
    {
      pasos.map((paso, i) => (
        <div
          class="relative flex gap-5 lg:block lg:px-4 lg:text-left"
          data-reveal
          style={`--reveal-delay: ${i * 80}ms`}
        >
          {/* Riel: ícono + conector vertical (sólo mobile) */}
          <div class="flex shrink-0 flex-col items-center lg:hidden">
            <span class="border-brand-600/40 bg-accent-800 relative z-10 flex size-14 items-center justify-center border">
              <Icon
                name={paso.icon}
                class="text-brand-600 size-6"
                aria-hidden="true"
              />
            </span>
            {i < pasos.length - 1 && (
              <span
                class="como-linea-v border-brand-600/30 mt-2 w-px flex-1 border-l-2 border-dashed"
                aria-hidden="true"
              />
            )}
          </div>

          {/*
            Conector horizontal (sólo desktop): arranca en el centro de ESTE
            ícono y mide el 100% del ancho de la columna, que —siendo todas
            las columnas iguales y sin gap entre ellas— es exactamente la
            distancia hasta el centro del ícono siguiente. No es left-1/2: el
            ícono va pegado al borde izquierdo de la columna, no centrado.

            left-11 (44px) = lg:px-4 del contenedor (16px) + la mitad del
            ícono size-14 (28px): el offset de un elemento absolute se mide
            desde el borde del padding-box del contenedor, no desde donde
            arranca su contenido, así que hay que sumarle el padding para
            llegar al mismo punto donde está el ícono.
          */}
          {i < pasos.length - 1 && (
            <span
              class="como-linea-h border-brand-600/30 pointer-events-none absolute top-7 left-11 hidden h-0 w-full border-t-2 border-dashed lg:block"
              aria-hidden="true"
            />
          )}

          <div class="min-w-0 flex-1 pb-8 lg:pb-0">
            {/*
              El ícono tiene fondo opaco (bg-accent-800): cualquier cosa detrás
              suyo queda tapada sin importar el z-index. En mobile el ícono
              vive aparte, en el riel de la izquierda, así que ahí el número
              va arriba a la derecha del bloque de texto sin taparse con nada.
              En desktop el ícono sí está en esta misma columna, así que el
              número se desplaza hacia arriba para asomar por encima en vez
              de quedar enteramente escondido detrás del círculo.
            */}
            <span
              class="text-brand-600/30 font-display pointer-events-none absolute -top-2 right-0 text-5xl font-bold select-none lg:-top-9 lg:right-auto lg:left-0"
              aria-hidden="true"
            >
              {paso.numero}
            </span>

            <span class="border-brand-600/40 bg-accent-800 relative z-10 mb-5 hidden size-14 items-center justify-center border lg:flex">
              <Icon
                name={paso.icon}
                class="text-brand-600 size-6"
                aria-hidden="true"
              />
            </span>

            <h3 class="relative text-xl font-semibold text-white">
              {paso.titulo}
            </h3>
            <p class="relative mt-2 text-base text-white/70">{paso.texto}</p>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-16 flex flex-col items-center text-center">
    <p class="text-lg text-white/80">
      La primera reunión es sin cargo y sin compromiso.
    </p>
    <Button href="/#contacto" variant="inverse" size="lg" class="mt-6">
      Agendá tu diagnóstico
    </Button>
  </div>
</Section>

<style>
  /*
    Igual que en Necesidades: el estado "sin dibujar" sólo existe si hay
    scripting y el usuario no pidió reduced-motion. Así, sin JS o con
    reduced-motion, las líneas aparecen ya completas (w-full / flex-1, las
    clases base del elemento) en vez de invisibles.

    La `transition` va sólo en la regla `.is-visible`, no en el estado base:
    si va en el estado base, el navegador la dispara apenas resuelve la hoja
    de estilos —de "w-full de Tailwind" a "width:0 de acá— y la línea arranca
    la página ya "dibujándose" sola, antes de que el IntersectionObserver
    dispare nada.
  */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .como-linea-h {
      width: 0;
    }

    .como-linea-h.is-visible {
      width: 100%;
      transition: width 900ms ease-out;
    }

    .como-linea-v {
      flex-grow: 0;
    }

    .como-linea-v.is-visible {
      flex-grow: 1;
      transition: flex-grow 900ms ease-out;
    }
  }
</style>

<script>
  const contenedor = document.querySelector('.como-pasos');
  const lineas = document.querySelectorAll<HTMLElement>(
    '.como-linea-h, .como-linea-v',
  );

  if (contenedor && lineas.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          lineas.forEach((linea) => linea.classList.add('is-visible'));
          observer.disconnect();
        }
      },
      { threshold: 0.3 },
    );
    observer.observe(contenedor);
  }
</script>
