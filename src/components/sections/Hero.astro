---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import fotoHero from '../../assets/hero/hero.jpg';
import { site } from '../../data/site';

const destacados = [
  { icon: 'lucide:calendar-check', text: '18 años de experiencia' },
  { icon: 'lucide:users', text: 'PyMEs, profesionales y emprendedores' },
  { icon: 'lucide:laptop', text: 'Gestión 100% digital' },
  { icon: 'lucide:message-circle', text: 'Respuesta en menos de 24 h' },
];
---

<section class="relative overflow-hidden bg-white">
  {/* Degradado sutil arriba a la derecha */}
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(55rem_38rem_at_88%_-12%,var(--color-brand-50),transparent_70%)]"
    aria-hidden="true"
  >
  </div>

  {
    /*
    Figura de marca en la esquina opuesta al degradado, recortada por el
    overflow-hidden de la section. -bottom-24 -left-24 a propósito: que se
    "salga" del borde en vez de quedar como una forma flotando adentro.
  */
  }
  <div
    class="brand-shape-growth pointer-events-none absolute -bottom-24 -left-24 h-[420px] w-[520px]"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-xl relative grid grid-cols-1 items-center gap-14 pt-14 pb-16 lg:min-h-[88vh] lg:grid-cols-[6fr_5fr] lg:gap-16 lg:pt-20 lg:pb-24"
  >
    {/* ---------------- Columna izquierda ---------------- */}
    <div class="hero-reveal">
      {
        /*
        56px es el tamaño de referencia en mobile, pero "tranquilidad." mide
        más que el ancho útil de un viewport de 390px. El clamp lo achica sólo
        en los teléfonos más angostos y llega a 56px de 415px para arriba.
      */
      }
      <h1
        class="mt-6 text-[clamp(2.75rem,13.5vw,3.5rem)] leading-[1.05] lg:text-[72px]"
      >
        Ordená tus números y hacé crecer tu empresa con {
          /*
          El inline-block mantiene "tranquilidad." como una sola unidad, para
          que el punto final nunca quede huérfano en su propio renglón. El
          punto va dentro del mismo nodo de texto a propósito: cualquier
          espacio en blanco entre etiquetas se colapsaría en un espacio visible
          antes del punto.
        */
        }<span class="relative inline-block">
          {
            /*
            El viewBox mide 12 de alto y el SVG se renderiza a 12px, así que la
            escala vertical es 1:1 y el trazo queda en 6px reales sin importar
            cuánto se estire a lo ancho. No usar
            vector-effect="non-scaling-stroke": el dash de pathLength se calcula
            en unidades de usuario y el trazo se pintaría en píxeles de
            pantalla, con lo que el subrayado sale cortado a la mitad.
          */
          }
          <svg
            class="hero-underline absolute inset-x-0 bottom-0 h-3 w-full translate-y-[30%]"
            viewBox="0 0 200 12"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8.6C26 5.1 58 3.4 97 4.3C133 5.1 168 7 197 5"
              stroke="var(--color-brand-600)"
              stroke-width="6"
              stroke-linecap="round"
              pathLength="1"></path>
          </svg>
          <span class="relative">tranquilidad.</span>
        </span>
      </h1>

      <p class="text-muted mt-6 max-w-[56ch] text-xl">
        Somos un estudio contable de {site.ciudad}. Desde {site.fundacion} acompañamos
        a empresas, emprendedores y profesionales en su gestión contable, impositiva
        y societaria, con respuestas claras y a tiempo.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button
          href="/#contacto"
          variant="primary"
          size="lg"
          class="w-full sm:w-auto"
        >
          Agendá una consulta sin cargo
        </Button>
        <Button
          href={site.whatsappHref}
          target="_blank"
          rel="noopener"
          variant="secondary"
          size="lg"
          class="w-full sm:w-auto"
        >
          <Icon
            name="simple-icons:whatsapp"
            class="size-5 shrink-0"
            aria-hidden="true"
          />
          Escribinos por WhatsApp
        </Button>
      </div>

      <p class="text-muted mt-5 text-sm">
        Primera reunión de diagnóstico sin costo ni compromiso.
      </p>
    </div>

    {/* ---------------- Columna derecha ---------------- */}
    <div class="bleed-right">
      {
        /*
        Sin recorte: la foto va entera, con su relación 3:2 original. Por eso
        no hay contenedor con aspect-ratio ni object-cover — se dimensiona
        sola con el width/height reales que le pone Astro.

        bleed-right saca la columna del container-xl para que la foto llegue
        pegada al borde derecho del viewport (ver global.css). El overflow-
        hidden de la <section> se encarga del sobrante de 100vw cuando hay
        barra de scroll, así que no aparece scroll horizontal.

        <Picture> en vez de <Image> para que pese lo menos posible: emite un
        <picture> con AVIF primero y WebP después, y el navegador se queda
        con el primero que entiende. Acá AVIF pesa la mitad que WebP (27 kB
        contra 43 kB en el corte de 640px), y el que no lo soporta cae en
        WebP sin ruido.

        fallbackFormat="webp" para no generar además una tanda de JPG que no
        descarga nadie: el <img> de adentro del <picture> sólo entra en juego
        en navegadores sin <picture> (ninguno desde 2016) o sin WebP (Safari
        anterior a 14). Con el default, esos JPG sumaban ~950 kB muertos al
        build.

        widths + sizes en vez de un solo width: al sangrar, esta columna pasa
        de ~440px en un portátil a ~1200px en un monitor ancho, así que un
        único tamaño quedaría corto en pantallas grandes (o sería un derroche
        en teléfonos). De lg para arriba la foto ocupa entre 43vw y 47vw según
        el ancho, así que 48vw cubre el caso máximo con un poco de aire.

        width={2000} además de widths: sin él, el `src` de respaldo sale con
        la imagen fuente entera (2560px) y ese archivo termina en el build al
        pepe. Con el tope, el respaldo es la variante de 2000px.
      */
      }
      <Picture
        src={fotoHero}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        alt="Esteban Asensio y Matías Martínez caminando por la vereda del estudio"
        width={2000}
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(min-width: 1024px) 48vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>

{/* ---------------- Franja de destacados ---------------- */}
<div class="border-line border-y bg-white">
  <div class="container-xl">
    <ul
      class="hero-strip flex snap-x snap-mandatory gap-8 overflow-x-auto py-8 md:grid md:grid-cols-4 md:gap-6 md:overflow-visible"
    >
      {
        destacados.map((item) => (
          <li class="flex min-w-[72%] shrink-0 snap-start items-center gap-3 sm:min-w-[46%] md:min-w-0 md:shrink">
            <Icon
              name={item.icon}
              class="text-brand-600 size-5 shrink-0"
              aria-hidden="true"
            />
            <span class="text-[15px] leading-snug">{item.text}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* --- Entrada escalonada de la columna izquierda --- */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-reveal > * {
    animation: hero-in 500ms ease-out both;
  }

  .hero-reveal > *:nth-child(1) {
    animation-delay: 0ms;
  }
  .hero-reveal > *:nth-child(2) {
    animation-delay: 60ms;
  }
  .hero-reveal > *:nth-child(3) {
    animation-delay: 120ms;
  }
  .hero-reveal > *:nth-child(4) {
    animation-delay: 180ms;
  }
  .hero-reveal > *:nth-child(5) {
    animation-delay: 240ms;
  }

  /* --- Subrayado dibujado a mano --- */
  @keyframes hero-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .hero-underline path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: hero-draw 700ms ease-out 400ms both;
  }

  /* --- Carrusel de destacados sin barra visible (sólo mobile) --- */
  .hero-strip {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .hero-strip::-webkit-scrollbar {
    display: none;
  }

  /* --- Movimiento reducido: todo aparece ya en su estado final --- */
  @media (prefers-reduced-motion: reduce) {
    .hero-reveal > * {
      animation: none;
    }

    .hero-underline path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
